# ==============================================================================
# ResearchMind AI — Environment Configuration Template
# Copy this file to .env and adjust as needed for local development.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api

# Server Binding
HOST=127.0.0.1
PORT=8000

# CORS / Frontend Origin
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths (relative to project root or absolute)
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/researchmind.db

# Authentication / Local User Mode
AUTH_ENABLED=false
DEFAULT_USER_EMAIL=local@researchmind.ai
DEFAULT_USER_NAME=Local Researcher

# Upload Limits
MAX_UPLOAD_MB=25

# Embedding Configuration (Week 3 baseline)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto

# Generator Configuration (Week 4 baseline)
# Supported providers: mock, openai, anthropic, gemini
GENERATOR_PROVIDER=mock
GENERATOR_MODEL=gpt-4o-mini
GENERATOR_API_KEY=
GENERATOR_TIMEOUT_SECONDS=30
GENERATOR_MAX_RETRIES=2
GENERATOR_BUDGET_USD=5.00

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api
